# ── Formulaire de contact (choisir au moins une option) ──

# Option 1 — Recommandé (API Vercel + Resend, clé côté serveur)
# Créez un compte sur https://resend.com et ajoutez ces variables dans Vercel → Settings → Environment Variables
RESEND_API_KEY=re_xxxxxxxxxxxx
CONTACT_TO_EMAIL=contact@kal-cooperation.com
CONTACT_FROM_EMAIL=Kal-Cooperation <onboarding@resend.dev>

# Option 2 — Fallback client (https://web3forms.com, gratuit)
# Utile en local ou si Resend n'est pas encore configuré
VITE_WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx