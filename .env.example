# ==============================================================================
# BOKENGI GROUP 2.0 — VARIABLES D'ENVIRONNEMENT
# ==============================================================================

# ── 1. GESTION DES DOMAINES ──
# Domaine officiel final de production : https://bokengi-group.com
# Domaine technique temporaire Vercel (preview/staging) : https://bokengi.vercel.app
# En local : http://localhost:3000
NEXT_PUBLIC_SERVER_URL=https://bokengi.vercel.app

# ── 2. BASE DE DONNÉES POSTGRESQL (NEON SERVERLESS) ──
# Chaîne de connexion standard PostgreSQL avec chiffrement SSL obligatoire
# Format : postgresql://user:password@ep-xyz.eu-central-1.aws.neon.tech/bokengi?sslmode=require
POSTGRES_URL=
DATABASE_URI=

# ── 3. SÉCURITÉ & AUTHENTIFICATION PAYLOAD CMS ──
# Clé secrète robuste (minimum 32 caractères alphanumériques aléatoires)
PAYLOAD_SECRET=

# ── 4. INFORMATIONS DE CONTACT CENTRALISÉES (PHASE 1.1) ──
# Variable maîtresse pour l'adresse e-mail professionnelle de l'organisation.
# Utilisée pour : Footer, Formulaires de contact/devis, Notifications système, Payload CMS, Resend.
# Ne pas renseigner de valeur définitive maintenant (à définir lors de la configuration DNS/MX).
CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_EMAIL=

# ── 5. STOCKAGE DES MÉDIAS (VERCEL BLOB STORAGE) ──
BLOB_READ_WRITE_TOKEN=

# ── 6. SERVICE D'EMAILS TRANSACTIONNELS (RESEND — PHASE 3) ──
# Clé d'API Resend pour l'expédition des notifications CRM et accusés de réception
RESEND_API_KEY=
# Adresse d'expédition officielle (utilisera contact@bokengi-group.com une fois les enregistrements DNS/MX configurés)
CONTACT_FROM_EMAIL="Bokengi Group <contact@bokengi-group.com>"

# ── 7. INTÉGRATION PRISE DE RENDEZ-VOUS (CAL.COM — PHASE 3 PRÉPARATION) ──
# Lien ou slug Cal.com pour planification en visioconférence directe
# Non activé publiquement par défaut (reste en standby jusqu'à validation)
NEXT_PUBLIC_CALCOM_LINK=
NEXT_PUBLIC_CALCOM_ENABLED=false

# ── 8. TÂCHES PLANIFIÉES & APERÇUS (CRON & PREVIEWS) ──
CRON_SECRET=
PREVIEW_SECRET=

# ── 9. INTÉGRATION STATUS PAGE (OPENSTATUS — PHASE 4 PRÉPARATION) ──
# Lien vers la page de statut public (ex: https://status.bokengi-group.com)
# Non activé publiquement sans validation explicite
NEXT_PUBLIC_OPENSTATUS_URL=https://status.bokengi-group.com
NEXT_PUBLIC_OPENSTATUS_ENABLED=false

# ── 10. MESURE D'AUDIENCE & ANALYTICS (UMAMI — PHASE 4 PRÉPARATION) ──
# Identifiant de site Umami et URL du script (respectueux de la vie privée)
# Non activé publiquement sans validation préalable
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=https://analytics.umami.is/script.js
NEXT_PUBLIC_UMAMI_ENABLED=false
