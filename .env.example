# ==============================================================================
# BOKENGI GROUP 2.0 — VARIABLES D'ENVIRONNEMENT (ERPNEXT & FRONTEND)
# ==============================================================================

# ── 1. GESTION DES DOMAINES ──
# Domaine officiel final de production : https://bokengi-group.com
# Domaine technique temporaire Vercel (preview/staging) : https://bokengi.vercel.app
# En local : http://localhost:3000
NEXT_PUBLIC_SERVER_URL=https://bokengi.vercel.app

# ── 2. BACKEND ERPNEXT v15 (SOURCE DE VÉRITÉ & CRM) ──
# URL de l'instance ERPNext / Frappe (ex: https://erp.bokengi-group.com)
ERPNEXT_API_URL=https://erp.bokengi-group.com
# Clé API générée pour l'utilisateur administrateur/API de Bokengi Group
ERPNEXT_API_KEY=
# Secret API généré pour l'utilisateur administrateur/API de Bokengi Group
ERPNEXT_API_SECRET=

# ── 3. INFORMATIONS DE CONTACT CENTRALISÉES (PHASE 1.1) ──
# Variable maîtresse pour l'adresse e-mail professionnelle de l'organisation.
# Utilisée pour : Footer, Formulaires de contact/devis, Notifications système, Resend.
CONTACT_EMAIL=contact@bokengi-group.com
NEXT_PUBLIC_CONTACT_EMAIL=contact@bokengi-group.com

# ── 4. SERVICE D'EMAILS TRANSACTIONNELS & NOTIFICATIONS (PHASE 3 / PHASE 7.1) ──
# Clé d'API Resend pour l'expédition des notifications CRM et accusés de réception
# (Optionnel : si non renseigné, ERPNext gère les notifications d'emails en natif)
RESEND_API_KEY=
# Adresse d'expédition officielle
CONTACT_FROM_EMAIL="Bokengi Group <contact@bokengi-group.com>"

# ── 5. INTÉGRATION PRISE DE RENDEZ-VOUS (CAL.COM) ──
# Lien ou slug Cal.com pour planification en visioconférence directe (ex: https://cal.com/bokengi-group ou bokengi-group)
NEXT_PUBLIC_CALCOM_LINK=https://cal.com/bokengi-group
NEXT_PUBLIC_CALCOM_ENABLED=true

# ── 6. INTÉGRATION STATUS PAGE (OPENSTATUS — CR-02) ──
# Lien vers la page de statut public
NEXT_PUBLIC_OPENSTATUS_URL=https://status.bokengi-group.com
NEXT_PUBLIC_OPENSTATUS_ENABLED=true

# ── 7. MESURE D'AUDIENCE & ANALYTICS (UMAMI — CR-01) ──
# Identifiant de site Umami et URL du script (respectueux de la vie privée)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=ebaf55dd-ba11-448c-97cb-d744953375d3
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_HOST_URL=
NEXT_PUBLIC_UMAMI_ENABLED=true

# ── 8. INTÉGRATION MATTERMOST PAR PÔLE (ROUTAGE ISOLÉ) ──
# Webhooks Mattermost dédiés par pôle métier (Strictement 1:1, aucune diffusion globale)
MATTERMOST_WEBHOOK_POLE_IT=
MATTERMOST_WEBHOOK_POLE_DIGITAL=
MATTERMOST_WEBHOOK_POLE_BUSINESS=
MATTERMOST_WEBHOOK_POLE_CONSULTING=
MATTERMOST_WEBHOOK_POLE_EVENTS=

