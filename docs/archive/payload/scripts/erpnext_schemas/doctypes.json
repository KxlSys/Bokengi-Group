        { "fieldname": "pole_name_en", "fieldtype": "Data", "label": "Pole Name (EN)" },
        { "fieldname": "slug_fr", "fieldtype": "Data", "label": "Slug URL (FR)", "reqd": 1, "unique": 1, "in_list_view": 1 },
