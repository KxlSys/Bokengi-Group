# Configuration d'Intégration Staging ERPNext (Modèle sans secrets)
# Copier sous .env.migration pour l'exécution locale

# Point d'accès ERPNext Staging
ERPNEXT_API_URL="https://erp-staging.bokengi-group.com"
ERPNEXT_API_KEY="bk_staging_key_example"
ERPNEXT_API_SECRET="bk_staging_secret_example"

# Point d'accès Cloudflare R2 Staging (Lecture Seule)
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="r2_key_example"
R2_SECRET_ACCESS_KEY="r2_secret_example"
R2_BUCKET_NAME="bokengi-media"
R2_PUBLIC_DOMAIN="https://pub-media.bokengi-group.com"

# Base de Données Source Payload (Lecture Seule)
DATABASE_URI="postgresql://postgres:password@127.0.0.1:5432/bokengi_payload"

# Contrôles d'Exécution
MIGRATION_DRY_RUN="true"
MIGRATION_LOG_LEVEL="info"
MIGRATION_JOURNAL_PATH="./scripts/migration/migration-journal.json"
