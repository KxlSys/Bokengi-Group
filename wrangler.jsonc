{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bokengi-group",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-02-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "bokengi-media"
    }
  ]
}
